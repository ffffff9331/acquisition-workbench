{
  "name": "acquisition-workbench",
  "private": true,
  "version": "0.38.0",
  "description": "A desktop workspace for repeatable acquisition and operations workflows.",
  "author": "Acquisition Operations Workbench",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:desktop": "node scripts/dev-desktop.cjs",
    "electron:dev": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:official-service": "node scripts/verify-official-service.cjs",
    "test:custom-service": "node scripts/verify-custom-service.cjs",
    "test:ai-service": "npm run test:official-service && npm run test:custom-service",
    "test:industry-packs": "node scripts/verify-industry-packs.cjs",
    "test:tactic-packs": "node scripts/verify-tactic-packs.cjs",
    "test:customer-events": "node scripts/verify-customer-events.cjs",
    "test:tactic-review": "node scripts/verify-tactic-review.cjs",
    "test:release-confirmation": "node scripts/verify-release-confirmation.cjs",
    "test:content-lead-context": "node scripts/verify-content-lead-context.cjs",
    "test:lead-work-queue": "node scripts/verify-lead-work-queue.cjs",
    "test:lead-response-sla": "node scripts/verify-lead-response-sla.cjs",
    "test:traffic-campaigns": "node scripts/verify-traffic-campaigns.cjs",
    "test:traffic-campaign-queue": "node scripts/verify-traffic-campaign-queue.cjs",
    "test:organic-experiment": "node scripts/verify-organic-experiment.cjs",
    "test:operations-core": "node scripts/verify-operations-core.cjs",
    "test:asset-library": "node scripts/verify-asset-library.cjs",
    "test:single-instance": "node scripts/verify-single-instance.cjs",
    "test:delivery-configuration": "node scripts/verify-delivery-configuration.cjs",
    "test:delivery-pack-auth": "node scripts/verify-delivery-pack-auth.cjs",
    "test:license-console": "node scripts/verify-license-console.cjs",
    "create:delivery-pack": "node scripts/create-delivery-pack.cjs",
    "license:console": "node scripts/license-console.cjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.acquisitionworkbench.desktop",
    "productName": "获客运营工作台",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "获客运营工作台"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true
  }
}
